# Supabase project URL and publishable key are available in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this value with NEXT_PUBLIC_ or use it in browser code.
SUPABASE_SECRET_KEY=

# Server-only canonical public origin for email confirmation and auth redirects.
# Set in Vercel Production to https://strauss-carwise.vercel.app (no path).
# Optional locally; empty uses the local request origin. Never put credentials here.
APP_SITE_URL=

# AI providers: server only. Empty providers are skipped in this exact order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional server-side model overrides. No NEXT_PUBLIC_ AI settings.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
